# Enterprise Knowledge Agent - local environment template (TASK-FND-07)
#
# Copy this file to `.env` in the repo root and fill in real values:
#
#   cp .env.example .env
#
# `.env` is picked up automatically by `docker compose` (it looks for a file
# named exactly `.env` next to docker-compose.yml) and is git-ignored (see
# .gitignore: `.env` / `.env.*` / `!.env.example`). NEVER commit a real `.env`.
#
# ---------------------------------------------------------------------------
# SECRET STRATEGY (ASDD §20.4, §27 · FR-AOI-002, FR-SEC-002)
# ---------------------------------------------------------------------------
# Three tiers, pick the right one per secret:
#
# 1. Docker Compose `.env` (this file, copied and filled in)
#    - For LOCAL-ONLY, low-sensitivity values: LocalStack's fixed fake AWS
#      credentials, local Postgres dev password, port overrides, deployment
#      names. LocalStack/Postgres here never hold real data or face the
#      internet, so these placeholders are fine to keep in `.env`.
#
# 2. .NET user-secrets (preferred for anything hitting a REAL external
#    service - i.e. Azure OpenAI)
#    - Run once per backend project that needs it:
#        dotnet user-secrets init --project src/api
#        dotnet user-secrets set "AzureOpenAI:ApiKey" "<real-key>" --project src/api
#        dotnet user-secrets init --project src/document-worker
#        dotnet user-secrets init --project src/agent-worker
#        dotnet user-secrets set "AzureOpenAI:ApiKey" "<real-key>" --project src/agent-worker
#    - user-secrets are stored OUTSIDE the repo (%APPDATA%\Microsoft\UserSecrets
#      on Windows, ~/.microsoft/usersecrets on Linux/macOS), keyed by a GUID in
#      each .csproj's <UserSecretsId> - never written to source control.
#    - Prefer Microsoft Entra ID (managed identity / service principal) auth
#      to Azure OpenAI over API keys wherever possible (AZURE_OPENAI_AUTH_MODE
#      below) - user-secrets is the fallback for the API-key path only.
#
# 3. Docker/orchestrator secrets (production deployments, out of scope for
#    this local-dev repo but noted for completeness)
#    - In a real deployment, AZURE_OPENAI_API_KEY and any other live
#      credentials should come from Docker secrets, Azure Key Vault, or the
#      orchestrator's native secret store - never baked into an image or a
#      committed `.env` file.
#
# Rules enforced across the codebase:
#   - Azure OpenAI keys are NEVER returned to the frontend (FR-AOI-002).
#   - No secret value is ever written to logs, audit records, or error
#     responses (see TASK-OBS-01 / TASK-ERR-01 / the Shared.Tests reflection
#     test banning Content/Prompt/Secret/Password/Token/ApiKey properties on
#     queue messages).
#   - CI includes an optional secret-scan step (TASK-FND-11) as a safety net,
#     not a substitute for the rules above.

# ---------------------------------------------------------------------------
# Compose topology / host port overrides
# ---------------------------------------------------------------------------
# Environment for the API and both workers. "Development" enables Swagger/
# OpenAPI UI and relaxed logging; use "Production" for anything resembling a
# real deployment.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Host ports for the two services published by default (see docker-compose.yml).
API_HTTP_PORT=8081
FRONTEND_HTTP_PORT=8080

# Host ports for Postgres/LocalStack, published ONLY under the "diagnostics"
# Compose profile (see docker-compose.override.yml):
#   docker compose --profile diagnostics up -d
POSTGRES_HOST_PORT=5432
LOCALSTACK_HOST_PORT=4566

# Build-time base URL for API calls from the frontend. Leave empty (default)
# to keep the SPA same-origin, relying on the Vite dev proxy (local `npm run
# dev`) or nginx's reverse proxy (compose) to forward /api and /hubs to the
# API - see TASK-FND-06. Only set this if the frontend is served from a
# different origin than the API.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Postgres (pgvector) - local dev credentials only, never used in production
# ---------------------------------------------------------------------------
POSTGRES_USER=eka
POSTGRES_PASSWORD=eka-local-dev-password
POSTGRES_DB=enterprise_knowledge_agent

# ---------------------------------------------------------------------------
# LocalStack (S3 + SQS emulation) - fake AWS endpoint/region/credentials
# ---------------------------------------------------------------------------
# LocalStack accepts any non-empty string as "test" AWS credentials; these
# are never valid against real AWS and are safe to keep in this template.
LOCALSTACK_DEBUG=0
LOCALSTACK_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 bucket names provisioned by the LocalStack init scripts (TASK-FND-08).
S3_SOURCE_FILES_BUCKET=rag-source-files
S3_GENERATED_EXPORTS_BUCKET=rag-generated-exports

# SQS queue names provisioned by the LocalStack init scripts (TASK-FND-08),
# each with a matching "-dlq" dead-letter queue and a redrive policy.
SQS_DOCUMENT_PROCESSING_QUEUE=document-processing
SQS_AGENT_EXECUTION_QUEUE=agent-execution
SQS_DELETION_JOBS_QUEUE=deletion-jobs

# ---------------------------------------------------------------------------
# Azure OpenAI (module 12 AOI binds/validates these; not yet wired into
# compose - see TASK-FND-07's "Out of Scope")
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# "entra" (Microsoft Entra ID / managed identity, preferred) or "apikey"
# (fallback). See TASK-AOI-02.
AZURE_OPENAI_AUTH_MODE=entra

# Only read when AZURE_OPENAI_AUTH_MODE=apikey. Prefer `dotnet user-secrets`
# over putting a real value here (see SECRET STRATEGY above) - leave blank
# when using entra auth.
AZURE_OPENAI_API_KEY=

AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment-name>
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_MAX_CONTEXT_TOKENS=128000
AZURE_OPENAI_MAX_OUTPUT_TOKENS=4096
AZURE_OPENAI_REQUEST_TIMEOUT_SECONDS=60
AZURE_OPENAI_MAX_RETRIES=3

# Set to false for reasoning-style chat deployments (e.g. gpt-5.5, o-series)
# that reject any non-default temperature value with a hard 400.
AZURE_OPENAI_CHAT_SUPPORTS_TEMPERATURE=true

# Set to false for reasoning-style chat deployments (e.g. gpt-5.5, o-series)
# that reject the legacy `max_tokens` request field with a hard 400 and
# require `max_completion_tokens` instead.
AZURE_OPENAI_CHAT_SUPPORTS_MAX_TOKENS=true

# Optional: ARM resource name + resource group (NOT the data-plane hostname),
# used only by deploy/scripts/check-aoai-connectivity.ps1|sh for an extra
# `az cognitiveservices account list-models` sanity check before the actual
# data-plane reachability check. Leave blank to skip that pre-check.
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_RESOURCE_GROUP=
