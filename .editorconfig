root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs}]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_diagnostic.CS1591.severity = none

# EF Core migration/snapshot files are scaffolded boilerplate (regenerated by
# `dotnet ef migrations add`), not hand-authored code - mark them generated so
# analyzers (e.g. CA1861 "prefer static readonly array over constant array
# argument", triggered by every composite-column CreateIndex call) don't fail
# the Release build over code we don't (and shouldn't) hand-edit.
[**/Migrations/*.cs]
generated_code = true

[*.{sln}]
indent_style = tab

[*.{json,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2
quote_type = single

[*.md]
trim_trailing_whitespace = false
