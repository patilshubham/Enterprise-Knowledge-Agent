<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-EnterpriseKnowledgeAgent.AgentWorker-488dbf1d-7146-4600-98c3-bf50f38fc1dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- TASK-OBS-02: metrics SDK + HttpClient auto-instrumentation. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\application\EnterpriseKnowledgeAgent.Application.csproj" />
    <ProjectReference Include="..\domain\EnterpriseKnowledgeAgent.Domain.csproj" />
    <ProjectReference Include="..\infrastructure\EnterpriseKnowledgeAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\shared\EnterpriseKnowledgeAgent.Shared.csproj" />
  </ItemGroup>
</Project>
